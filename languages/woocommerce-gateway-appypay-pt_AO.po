# EN: Checkout with Multicaixa Express.
#: includes/payment-methods/class-wc-gateway-appypay-gpo.php:213
msgid "Checkout with GPO payment. "
msgstr "Check-out com pagamento com Multicaixa Express."

# Correct EN: Checkout with Multicaixa Express payment, but failed due to time limit.
#: includes/payment-methods/class-wc-gateway-appypay-gpo.php:188
msgid "Checkout with GPO payment. but failed due to timeout issue"
msgstr ""
"Check-out com pagamento com Multicaixa Express, mas falhou por ter passado o "
"tempo limite."

