msgstr "Checkout com pagamento com UNITEL Mobile Money."

#: includes/payment-methods/class-wc-gateway-appypay-umm.php:181
msgid "Checkout with UMM payment.  waiting for confirmation"
msgstr "Check-out com pagamento UNITEL Mobile Money, a espera de confirmação."

# Checkout with UNITEL Mobile Money payment, but failed due to timeout.
#: includes/payment-methods/class-wc-gateway-appypay-umm.php:179
msgid "Checkout with UMM payment. but failed due to timeout issue"
msgstr ""
"Check-out com pagamento com UNITEL Mobile Money, mas falhou por ter passado "
"o tempo limite."

