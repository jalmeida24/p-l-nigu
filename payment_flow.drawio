(payment state)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="830" y="220" width="90" height="70" as="geometry"/></mxCell><mxCell id="emis" value="EMIS-GPO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1120" y="85" width="120" height="50" as="geometry"/></mxCell><mxCell id="valworker" value="validation worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1000" y="260" width="130" height="40" as="geometry"/></mxCell><mxCell id="d_timeout" value="Not
Timeout?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="950" y="160" width="80" height="60" as="geometry"/></mxCell><mxCell id="d_timeout2" value="Timeout /
404?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1150" y="170" width="80" height="60" as="geometry"/></mxCell><mxCell id="d_retrylimit" value="Atingiu limite
retentativas?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1150" y="280" width="90" height="60" as="geometry"/></mxCell><mxCell id="markfail" value="Marcar pagamento
como inconforme" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1150" y="390" width="140" height="50" as="geometry"/></mxCell><mxCell id="cronjob" value="polling-cronjob" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="330" y="430" width="110" height="30" as="geometry"/></mxCell><mxCell id="d_pending" value="Existem Pagamentos
Pendentes?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="460" y="410" width="110" height="70" as="geometry"/></mxCell><mxCell id="e1" value="1. open plugin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="user" target="browser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="2. submit data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="browser" target="localserver"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="3/4. request/response" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="localserver" target="apicentral"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="5. fields" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="pluginfields" target="browser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="6. enqueue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="apicentral" target="queue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="7. dequeue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="queue" target="workers"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e71" value="7.1 read/get
estado pagamento" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="workers" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="8. call EMIS-GPO" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;" edge="1" parent="1" source="workers" target="emis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="workers" target="d_timeout"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="NO - retry" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d_timeout" target="emis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="d_timeout" target="valworker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="validate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="valworker" target="emis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="emis" target="d_timeout2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="update" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="valworker" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="d_timeout2" target="d_retrylimit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="NO - retry" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d_retrylimit" target="emis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="d_retrylimit" target="markfail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="markfail" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="browser" target="cronjob"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="cronjob" target="d_pending"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="YES" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;" edge="1" parent="1" source="d_pending" target="apicentral"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="NO - wait interval" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="d_pending" target="cronjob"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="d_pending" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="imp_title" value="SUGGESTED IMPROVEMENTS" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="300" height="30" as="geometry"/></mxCell><mxCell id="imp1" value="1) Add exponential backoff + jitter
between retries (workers &lt;-&gt; EMIS-GPO)
instead of immediate retry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="230" height="80" as="geometry"/></mxCell><mxCell id="imp2" value="2) Circuit breaker around EMIS-GPO
calls to fail fast when the gateway
is degraded, instead of retrying
every request individually." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="270" y="560" width="230" height="80" as="geometry"/></mxCell><mxCell id="imp3" value="3) Prefer webhook/callback from
EMIS-GPO over polling-cronjob
to cut latency &amp; load." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="560" width="230" height="80" as="geometry"/></mxCell><mxCell id="imp4" value="4) Idempotency key per payment to
prevent race conditions between
worker flow and polling-cronjob
updating the same record." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="770" y="560" width="230" height="80" as="geometry"/></mxCell><mxCell id="imp5" value="5) On 'Marcar como inconforme':
trigger alert + manual reconciliation
queue / notify merchant, not a dead end." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="560" width="230" height="80" as="geometry"/></mxCell><mxCell id="imp6" value="6) Add observability: distributed
tracing across API-&gt;Queue-&gt;Worker-&gt;
EMIS-GPO, plus metrics on retry/
timeout/failure rates." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="230" height="80" as="geometry"/></mxCell><mxCell id="imp7" value="7) Cluster/replicate DB and Queue
(both are single points of failure
in the critical payment path)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="270" y="660" width="230" height="80" as="geometry"/></mxCell><mxCell id="imp8" value="8) Secure plugin data: enforce TLS,
server-side signature validation,
and tamper checks on merchant fields." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="660" width="230" height="80" as="geometry"/></mxCell><mxCell id="imp9" value="9) Label all decision-entry conditions
explicitly in the diagram for easier
audit/onboarding." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="770" y="660" width="230" height="80" as="geometry"/></mxCell><mxCell id="l1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#b85450;endArrow=none;startArrow=none;" edge="1" parent="1" source="imp1" target="d_timeout"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#b85450;endArrow=none;startArrow=none;" edge="1" parent="1" source="imp2" target="emis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#b85450;endArrow=none;startArrow=none;" edge="1" parent="1" source="imp3" target="cronjob"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#b85450;endArrow=none;startArrow=none;" edge="1" parent="1" source="imp4" target="d_pending"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#b85450;endArrow=none;startArrow=none;" edge="1" parent="1" source="imp5" target="markfail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#b85450;endArrow=none;startArrow=none;" edge="1" parent="1" source="imp7" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#b85450;endArrow=none;startArrow=none;" edge="1" parent="1" source="imp8" target="pluginfields"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
