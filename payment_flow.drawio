        <mxCell id="title1" value="Payment Processing Flow (Plugin GPO -&gt; PST API -&gt; Workers -&gt; EMIS-GPO)
with Suggested Improvements Highlighted in Red" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-20" y="-70" width="1250" height="50" as="geometry"/></mxCell><mxCell id="user" value="Utilizador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="40" height="60" as="geometry"/></mxCell><mxCell id="browser" value="Browser + Plugin Cliente GPO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="240" y="200" width="140" height="90" as="geometry"/></mxCell><mxCell id="pluginfields" value="Fields: Nome do Comerciante, Morada,
